#!/usr/bin/env python3
"""Generate HA location selector labels from the installed aerial-danger library."""

import argparse
import json
import sys
from pathlib import Path

from aerial_danger.location_presets import LOCATION_PRESETS


def main(root: Path, *, check: bool = False) -> int:
    """Update only location options, or report drift without writing files."""
    directory = root / "custom_components/aerial_danger/translations"
    updates = {}
    for language in ("en", "uk"):
        path = directory / f"{language}.json"
        original = path.read_text(encoding="utf-8")
        data = json.loads(original)
        data["selector"]["region_presets"]["options"] = {
            region.id: region.names[language] for region in LOCATION_PRESETS.values()
        }
        data["selector"]["locality_presets"]["options"] = {
            locality.id: locality.names[language]
            for region in LOCATION_PRESETS.values()
            for locality in region.localities.values()
        }
        updated = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
        if updated != original:
            updates[path] = updated
    if check:
        for path in updates:
            sys.stderr.write(f"Location translations out of date: {path}\n")
        return int(bool(updates))
    for path, updated in updates.items():
        path.write_text(updated, encoding="utf-8")
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check without writing")
    args = parser.parse_args()
    raise SystemExit(main(Path(__file__).resolve().parents[1], check=args.check))
