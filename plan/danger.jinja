{% set AREA_PLACEHOLDER = '{area}' %}
{% set DELIMITER = '|||' %}
{% set REPORT_LENGTH = 50 %}

{# Map danger strings to specific areas #}
{% macro map_areas(strings, areas) %}
  {% set result = namespace(list=[]) %}
  {% for s in strings %}
    {% if AREA_PLACEHOLDER in s %}
      {% for area in areas %}
        {% set value = s.replace(AREA_PLACEHOLDER, area) %}
        {% if value not in result.list %}
          {% set result.list = result.list + [ value ] %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% set result.list = result.list + [ s ] %}
    {% endif %}
  {% endfor %}
  {{ result.list | join(DELIMITER) }}
{% endmacro %}

{# Check if any keywords are included in the message #}
{# {% macro includes_any(keywords, message) %}
  {{ keywords.split(DELIMITER) | select('in', message) | list | count > 0 }}
{% endmacro %} #}
{% macro includes_any(keywords, message) %}
  {# Split the combined string into list of keywords #}
  {% set list = keywords.split(DELIMITER) %}
  {% set found = namespace(result=false) %}
  {% for keyword in list %}
    {% if message is search(keyword, ignorecase=True) %}
      {% set found.result = true %}
    {% endif %}
  {% endfor %}
  {{ found.result }}
{% endmacro %}

{# Define city areas for missiles #}
{% set city = [
  '\\bки(ї|є)в(а|у|ом|е|і)?\\b'
] %}

{# Define city areas for drones #}
{% set neighborhood = [
  '\\bнив(ки|ками|ок)\\b',
  '\\bсвятошин(а|у|ом|і)?\\b',
  '\\bантонов',
  '\\bакадем',
  'берковець',
  'cирець',
  'cирця',
  '\\bшулявк(а|и)\\b',
  'галаган'
] %}

{# Keywords for generic danger #}
{% set generic_danger = [
  '(буде|бути) гучно',
  'в укриття',
  'перебувайте в укритті',
  'будьте обережними',
  'курс(ом)? на',
  '{area} увага!',
  'дві стіни',
  '2 стіни',
  'від вікон',
  'вглиб будівель!',
] %}

{# Keywords for danger in city area #}
{% set missile_danger = [
  '🔴🚀',
  '🟡🚀',
  '🔴❗️',
  'балістик',
  'балістика на {area}',
  'наближення балістики',
  'вихід балістики',
  'вихід бр',
  'cпуск балістики',
  'кинджал',
  'швидкісна ціль',
  'швидкісна повітряна ціль',
  'кр на',
  'кр повз',
  'кр від',
  'кр {area}',
  'група кр',
  'групи кр',
  'кр через',
  'підліт кр',
  'групи ракет',
  'крилаті ракети',
  'крилатих ракет',
  'крилата ракета',
  'ракета заходить',
  'ракети заходять',
  'ракети на {area}',
  'ракета на {area}',
  '{area} ракета',
  'ракета {area}',
