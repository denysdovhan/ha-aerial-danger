  'спуск {area}',
  'спуск на {area}',
  '{area} спуск!',
] %}
{# Keywords for danger in neighborhood area #}
{% set drone_danger = [
  '🟡🛵',
  'заліт',
  'бпла',
  '{area}!',
  '{area} рух!',
  'маневри',
  'шахед на {area}',
  '\\d+х {area}'
] %}

{% macro drone_attack(message) %}
  {% set message = message | lower %}
  {% set drone_keywords = map_areas(drone_danger + generic_danger, neighborhood) %}
  {% set areas_keywords = neighborhood | join(DELIMITER) %}
  {% set drone_attack = includes_any(drone_keywords, message) | bool %}
  {% set in_area = includes_any(areas_keywords, message) | bool %}
  {{ drone_attack and in_area }}
{% endmacro %}

{% macro missile_attack(message) %}
  {% set message = message | lower %}
  {% set missile_keywords = map_areas(missile_danger + generic_danger, city + neighborhood) %}
  {% set areas_keywords = (city + neighborhood) | join(DELIMITER) %}
  {% set missile_attack = includes_any(missile_keywords, message) | bool %}
  {% set in_area = includes_any(areas_keywords, message) | bool %}
  {{ missile_attack and in_area }}
{% endmacro %}

{% macro in_danger(message) %}
  {% set message = message | lower %}
  {% set not_report = message | length < REPORT_LENGTH %}
  {% set drone_attack = drone_attack(message) | bool %}
  {% set missile_attack = missile_attack(message) | bool %}
  {{ not_report and (drone_attack or missile_attack) }}
{% endmacro %}

